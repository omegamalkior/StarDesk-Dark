<!-- Dark and AMOLED versions of artwork that was drawn for the light UI.
     Each file keeps the resource path of its light original under a :/dark or :/amoled prefix,
     so themedAsset(":/uikit/common_modal_bk@4x.png") finds ":/dark/uikit/common_modal_bk@4x.png". -->
<RCC>
    <qresource prefix="/dark">
        <file alias="app_icon/stardesk_dark.ico">dark/app_icon/stardesk_dark.ico</file>
        <file alias="app_icon/stardesk_dark_256.png">dark/app_icon/stardesk_dark_256.png</file>
        <file alias="brand/splash_window_en.png">dark/brand/splash_window_en.png</file>
